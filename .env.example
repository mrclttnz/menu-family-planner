# Menu Design Environment Configuration Example
# Copy this file to .env and configure secrets accordingly

# Application Environment (development | production | testing)
ENVIRONMENT=development

# Security & Secrets (Change in production! Must be at least 32 characters)
SECRET_KEY=menu-design-dev-secret-key-change-in-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection URL
# SQLite (development): sqlite:///./app.db
# PostgreSQL (production): postgresql://user:password@localhost:5432/menu_design
DATABASE_URL=sqlite:///./app.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
