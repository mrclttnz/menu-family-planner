# ==============================================================================
# MENU DESIGN - Production Environment Variables Example
# Copy this file to .env and replace placeholders with secure random credentials:
#   cp .env.example .env
# ==============================================================================

# Application Environment (production / development)
ENVIRONMENT=production

# Security: Secret Key for JWT token signing (minimum 32 characters)
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_secure_random_string_at_least_32_characters_long!

# Allowed CORS Origins (comma-separated, e.g. your local IP and/or your Cloudflare Tunnel domain)
# Examples:
# CORS_ORIGINS=http://localhost:8000,http://192.168.1.50:8000,https://menu.yourdomain.com
CORS_ORIGINS=http://localhost:8000

# PostgreSQL Credentials (local container)
POSTGRES_DB=menu_design
POSTGRES_USER=menu_user
POSTGRES_PASSWORD=generate_a_strong_database_password_here!
DATABASE_URL=postgresql+psycopg://menu_user:generate_a_strong_database_password_here!@postgres:5432/menu_design

# Cloudflare Tunnel Token (from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels)
# Optional if running locally without external tunnel exposure:
# TUNNEL_TOKEN=eyJhIjoi...
