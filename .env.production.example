# ==============================================================================
# MENU DESIGN - QNAP Production Environment Variables (.env.production.example)
#
# INSTRUCTIONS:
# 1. Copia questo file in '.env.production' sul tuo NAS QNAP (o nella cartella di deploy):
#    cp .env.production.example .env.production
# 2. Compila i valori contrassegnati o personalizzali in base al tuo ambiente.
# 3. NON committare mai .env.production nel repository Git (è escluso da .gitignore).
# ==============================================================================

# Application Environment
ENVIRONMENT=production

# Docker Hub Image Configuration
# Sostituisci <DOCKERHUB_USERNAME> con il tuo username Docker Hub
APP_IMAGE=myuser/menu-design-app:latest

# Port Mappings
# Porta dell'app sul QNAP (accessibile anche in LAN locale, es. http://<IP_QNAP>:8000)
APP_PORT_MAPPING=8000:8000

# Porta PostgreSQL per accesso locale LAN (es. da DBeaver / pgAdmin sulla tua rete privata).
# Opzione 1: "5432:5432" (accessibile su tutte le interfacce LAN del QNAP; il router NON apre porte verso internet)
# Opzione 2 (Consigliata per binding esplicito LAN): "192.168.1.100:5432:5432" (sostituisci con IP LAN del QNAP)
POSTGRES_PORT_MAPPING=5432:5432

# Security: Secret Key per la firma dei token JWT (minimo 32 caratteri casuali)
# Genera con: openssl rand -hex 32
SECRET_KEY=CHANGEME_GENERATE_WITH_OPENSSL_RAND_HEX_32_MIN_32_CHARS!

# Allowed CORS Origins (separati da virgola)
# Includi sia l'indirizzo LAN del tuo QNAP che il dominio pubblico esposto via Cloudflare Tunnel
# Esempio: CORS_ORIGINS=http://localhost:8000,http://192.168.1.100:8000,https://menu.tuodominio.com
CORS_ORIGINS=http://localhost:8000,https://menu.tuodominio.com

# PostgreSQL Credentials
POSTGRES_DB=menu_design
POSTGRES_USER=menu_user
POSTGRES_PASSWORD=CHANGEME_GENERATE_A_STRONG_DB_PASSWORD!

# Cloudflare Tunnel Token
# Ottenibile dalla dashboard Cloudflare Zero Trust -> Networks -> Tunnels
# Crea un Tunnel, copia il token di connessione e configura il Public Hostname verso:
#   Service: HTTP
#   URL: app:8000
TUNNEL_TOKEN=CHANGEME_CLOUDFLARE_TUNNEL_TOKEN_HERE
